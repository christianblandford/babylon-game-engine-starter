    "@babylonjs/inspector": "^9.36.0",
    "@babylonjs/loaders": "^9.36.0",
    "@babylonjs/materials": "^9.36.0",
    "@recast-navigation/core": "0.44.0",
    "@recast-navigation/generators": "0.44.0",
    "lil-gui": "^0.21.0"
  },
  "devDependencies": {
    "@babylonjs/ktx2decoder": "^9.36.0",
