    "map:make-town": "node tools/map.mjs make-town",
    "map:make-hall": "node tools/map.mjs make-hall",
    "texture:get": "node tools/textures.mjs",
    "model:get": "node tools/models.mjs"
  },
  "dependencies": {
    "@babylonjs/addons": "^9.36.0",
